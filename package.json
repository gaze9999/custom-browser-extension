{
  "name": "g-custom-extension-pack",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check:public": "python tools/check-public-content.py --history --index",
    "start": "node tools/build.mjs --watch",
    "check:syntax": "node --check extensions/threads-login-remover/content.js && node --check tools/build.mjs",
    "build": "pnpm check:syntax && node tools/build.mjs",
    "check": "pnpm build"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
